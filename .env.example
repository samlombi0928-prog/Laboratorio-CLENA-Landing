# Opcional: `docker compose up` funciona sin este archivo con valores de desarrollo.
# Copiar a .env solo para cambiar algo. Nunca subir el .env al repositorio.
DB_USERNAME=clena
DB_PASSWORD=cambie-esta-clave
DB_NAME=clena
CORS_ORIGIN=http://localhost:8080
# Minimo 32 caracteres, distinto en cada entorno
JWT_ACCESS_SECRET=cambie-este-secreto-por-uno-de-al-menos-32-caracteres
VITE_API_URL=http://localhost:3000/api/v1
