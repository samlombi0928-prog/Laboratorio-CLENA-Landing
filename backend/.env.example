# Copie este archivo como .env y ajuste los valores. Nunca suba el .env al repositorio.

# development | production | test
NODE_ENV=development
PORT=3000

# PostgreSQL 15 o superior
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=clena
DB_PASSWORD=cambie-esta-clave
DB_NAME=clena

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173

# Secreto para firmar los access tokens: mínimo 32 caracteres, distinto en cada entorno.
# Se puede generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambie-este-secreto-por-uno-de-al-menos-32-caracteres
# Duración del access token en segundos (60 a 3600)
JWT_ACCESS_TTL_SECONDS=900
# Duración de la sesión (refresh token) en días (1 a 90)
REFRESH_TOKEN_TTL_DAYS=7

# Correo (SMTP). En desarrollo se usa Mailpit: los correos se ven en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="CLENA Digital <no-responder@clena.local>"
